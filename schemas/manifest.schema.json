{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikasir.github.io/ha-contract-generated-ui/schemas/manifest.schema.json",
  "title": "Home Assistant panel manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "nikas.home-assistant/panel-manifest/v1"},
    "kind": {"const": "PanelManifest"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
        "description": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dashboard_path", "views"],
      "properties": {
        "dashboard_path": {
          "type": "string",
          "pattern": "^/[a-z0-9][a-z0-9/_-]*$"
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/view"}
        }
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract"],
      "properties": {
        "contract": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "instance": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "order": {"type": "integer", "minimum": 0},
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "path", "modules"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "title": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "order": {"type": "integer", "minimum": 0},
        "modules": {
          "type": "array",
          "items": {"$ref": "#/$defs/module"}
        }
      }
    }
  }
}
