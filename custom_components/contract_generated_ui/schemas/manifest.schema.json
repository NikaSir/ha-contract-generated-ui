{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikasir.github.io/ha-contract-generated-ui/schemas/manifest.schema.json",
  "title": "Home Assistant panel manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "nikas.home-assistant/panel-manifest/v1"},
    "kind": {"const": "PanelManifest"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
        "description": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dashboard_path", "views"],
      "properties": {
        "dashboard_path": {
          "type": "string",
          "pattern": "^/[a-z0-9][a-z0-9/_-]*$"
        },
        "navigation": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {
            "type": "string",
            "pattern": "^/[a-z0-9][a-z0-9/_-]*$"
          }
        },
        "app_shell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active"],
          "properties": {
            "active": {"enum": ["home", "actions", "infrastructure"]},
            "routes": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "home": {"type": "string", "pattern": "^/[a-z0-9][a-z0-9/_-]*$"},
                "actions": {"type": "string", "pattern": "^/[a-z0-9][a-z0-9/_-]*$"},
                "infrastructure": {"type": "string", "pattern": "^/[a-z0-9][a-z0-9/_-]*$"}
              }
            }
          }
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/view"}
        }
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "order", "bindings"],
      "properties": {
        "contract": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "instance": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "title": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["status", "telemetry", "diagnostic"]},
          "uniqueItems": true
        },
        "bindings": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*){2,}$"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "path", "order", "modules"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "title": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "order": {"type": "integer", "minimum": 0},
        "renderer": {"enum": ["operational_v1", "house_home_v1", "actions_home_v1", "infrastructure_summary_v1"]},
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/module"}
        }
      }
    }
  }
}
