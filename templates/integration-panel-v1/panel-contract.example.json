{
  "api_version": "nikas.home-assistant/integration-panel/v1",
  "template": "NikaS Integration Panel Template v1.9",
  "navigation_contract_version": "1.1",
  "panel": {
    "id": "example",
    "title": "Example Panel",
    "path": "/dashboard-example",
    "owner": "example_integration",
    "preferred_view": "overview",
    "ui_version": "1.0.0"
  },
  "target": {
    "primary": "iPhone Pro Max portrait",
    "control_viewport_css_px": [430, 932],
    "mobile_first": true,
    "desktop_is_secondary": true,
    "horizontal_scroll_allowed": false,
    "desktop_max_content_width_px": 1280
  },
  "header": {
    "grid": "52px minmax(0,1fr) 52px",
    "narrow_grid": "48px minmax(0,1fr) 48px",
    "left_action": "home_assistant_system_menu",
    "left_icon": "mdi:menu",
    "left_event": "hass-toggle-menu",
    "action_plaque_px": 44,
    "action_radius_px": 16,
    "action_icon_px": 25,
    "title_px": 23,
    "subtitle_px": 14,
    "narrow_title_px": 21,
    "narrow_subtitle_px": 13,
    "min_touch_target_px": 44,
    "title_alignment": "viewport_center",
    "title_is_button": true,
    "title_second_line": "UI vX.Y.Z",
    "title_action": "return_to_source_base_panel",
    "title_plaque": {
      "reference": "LIDER",
      "min_width": "min(290px,100%)",
      "min_height_px": 44,
      "padding": "5px 14px",
      "radius_px": 16,
      "background_primary_mix_percent": 5,
      "border_primary_mix_percent": 24,
      "shadow": "0 5px 16px rgba(23,45,76,.06)",
      "pressed_background_primary_mix_percent": 13,
      "pressed_border_primary_mix_percent": 42,
      "pressed_shadow": "0 2px 7px rgba(23,45,76,.05)",
      "focus_outline_px": 2,
      "focus_outline_offset_px": 2
    },
    "source_route_handoff_key": "nikas.specialized.source_route.v1",
    "source_route_timestamp_key": "nikas.specialized.source_route_at.v1",
    "source_route_pair_required": true,
    "source_route_valid_age_ms": [0, 30000],
    "source_route_partial_write_rollback": true,
    "allowed_source_routes": ["/dashboard-house-v11/home", "/dashboard-actions/home", "/dashboard-infrastructure/overview"],
    "browser_history_back_allowed": false,
    "show_brand_icon": false,
    "max_actions": 1,
    "preferred_action": "refresh"
  },
  "device_context": {
    "enabled": false,
    "placement": "below_header",
    "peer_physical_devices_only": true,
    "fixed_order": true,
    "persist_across_views": true,
    "selected_device_only_content": true
  },
  "hero": {
    "required_on_overview": true,
    "purpose": "answer current system state",
    "max_primary_statuses": 1,
    "optional_compact_badge": true
  },
  "cards": {
    "radius_px": 22,
    "padding_px": 18,
    "vertical_gap_px": 14,
    "shadow": "minimal"
  },
  "content": {
    "mobile_columns": 1,
    "desktop_columns": 2,
    "primitives": [
      "status_card",
      "metric_card",
      "state_row",
      "action_card",
      "alert",
      "diagram"
    ]
  },
  "navigation": {
    "mode": "full_width_fixed_bottom_tab_bar",
    "floating": false,
    "safe_area": true,
    "outside_scroll_region": true,
    "min_primary_items": 3,
    "max_primary_items": 5,
    "equal_dynamic_columns": true,
    "icon_px": 28,
    "label_px": 12,
    "label_weight": 700,
    "touch_target_px": 52,
    "views": ["overview", "control", "diagnostics"]
  },
  "semantics": {
    "healthy": "green",
    "active": "primary",
    "warning": "amber",
    "fault": "red",
    "unknown": "grey",
    "unknown_is_healthy": false,
    "unavailable_is_healthy": false
  },
  "loading": {
    "show_shell": true,
    "show_header": true,
    "show_bottom_tab_bar": true,
    "show_skeleton": true,
    "blank_screen_allowed": false
  },
  "long_press": {
    "entity_backed_elements": "home_assistant_more_info",
    "header_actions": "none",
    "bottom_navigation": "none"
  },
  "zoom": {
    "viewport_count": 1,
    "work_area_only": true,
    "range_percent": [75, 200],
    "native_vertical_scroll_at_100": true,
    "one_finger_pan_above_100_only": true,
    "axis_aware_bounds": true,
    "snap_to_100_percent_range": [97, 103],
    "reset_gesture": "two_finger_double_tap",
    "reset_message": "Масштаб 100%",
    "permanent_controls": false
  },
  "rendering": {
    "mount_shell_once": true,
    "point_patch_telemetry": true,
    "lazy_cache_tabs_and_devices": true,
    "routine_shadow_root_replacement": false,
    "persistent_background_and_viewport": true
  },
  "connection_indicator": {
    "enabled": false,
    "enable_only_by_explicit_request": true,
    "primary_values": ["Локально", "Облако", "Резерв", "Нет связи", "Нет данных"],
    "freshness_values": ["Данные актуальны", "Данные устарели", "Нет данных"],
    "primary_font_px": 16,
    "freshness_font_px": 13,
    "status_tinted_background": true
  },
  "typography": {
    "meaningful_min_px": 12,
    "meaningful_max_px": 25,
    "schematic_redundant_annotation_px": [9, 10]
  },
  "data_truth": {
    "entity_source": "integration_or_ha_registry",
    "invented_entity_ids": false,
    "fixed_entity_ids": "none",
    "unknown_unavailable": "explicit",
    "command_policy": "integration_services"
  },
  "frontend_delivery": {
    "mode": "self_contained_bundle",
    "production_entrypoints": 1,
    "deterministic_build": true,
    "runtime_shared_template_dependency": false,
    "runtime_previous_version_imports": false,
    "cache_busting": "query_ui_version",
    "github_releases": false
  }
}
